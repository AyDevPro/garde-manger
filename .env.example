# ── Base de données ──────────────────────────────────────────────
POSTGRES_USER=gardemanger
POSTGRES_PASSWORD=change-moi-en-quelque-chose-de-long
POSTGRES_DB=gardemanger
# Utilisé par l'API (dans docker-compose le host est "db")
DATABASE_URL=postgres://gardemanger:change-moi-en-quelque-chose-de-long@db:5432/gardemanger

# ── Foyer ────────────────────────────────────────────────────────
# Nom affiché sur l'écran de connexion
HOUSEHOLD_NAME=Maison
# Mot de passe initial du foyer (créé au premier démarrage seulement).
# Changez-le ensuite depuis Réglages › Sécurité.
HOUSEHOLD_PASSWORD=change-moi-aussi

# ── Serveur ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Mettre à false uniquement en développement HTTP local
COOKIE_SECURE=true
# Durée de session (jours) — "session longue durée"
SESSION_DAYS=180
# Origines autorisées, séparées par des virgules (vide = même origine)
ALLOWED_ORIGINS=

# ── Reverse-proxy HTTPS (Caddy) ──────────────────────────────────
# Domaine servi. Un vrai domaine public → certificat Let's Encrypt automatique.
# "localhost" ou un nom .local → certificat interne (réseau domestique).
DOMAIN=localhost
# Adresse pour les avis d'expiration Let's Encrypt (facultatif)
ACME_EMAIL=

# ── Divers ───────────────────────────────────────────────────────
# Fuseau du foyer : détermine ce que « aujourd'hui » veut dire pour les dates.
TZ=Europe/Paris
# Nombre de jours de sauvegardes conservés
BACKUP_KEEP_DAYS=14
