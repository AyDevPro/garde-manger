# ── Exemple d'environnement PRODUCTION (VPS aydev, derrière Traefik) ──────────
# Copier en `.env` puis renseigner les secrets. `.env` n'est jamais versionné.
#
#   cp .env.prod.example .env && nano .env && docker compose up -d --build

# ── Base de données (interne au réseau Docker, jamais exposée) ────────────────
POSTGRES_USER=gardemanger
POSTGRES_PASSWORD=REMPLACER_PAR_UN_SECRET_LONG
POSTGRES_DB=gardemanger

# ── Foyer ─────────────────────────────────────────────────────────────────────
HOUSEHOLD_NAME=Maison
# ≥ 8 caractères. Lu uniquement à la 1re création, puis modifiable dans l'app.
HOUSEHOLD_PASSWORD=REMPLACER_MOT_DE_PASSE_FOYER

# ── Serveur ───────────────────────────────────────────────────────────────────
# true : Traefik termine le TLS, l'app est servie en HTTPS → cookies sécurisés.
COOKIE_SECURE=true
SESSION_DAYS=180
# Vide = même origine (l'app et l'API sont sur garde-manger.aydev.app).
ALLOWED_ORIGINS=

# ── Divers ────────────────────────────────────────────────────────────────────
TZ=Europe/Paris
BACKUP_KEEP_DAYS=14

# NB : pas de DOMAIN / ACME_EMAIL ici — le TLS et le domaine
# (garde-manger.aydev.app) sont gérés par le Traefik du VPS via les labels
# du docker-compose.yml, pas par un Caddy embarqué.
